{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "framework": null,
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/rpc.js": {
      "maxDuration": 60,
      "includeFiles": "app/**"
    },
    "api/backup.js": {
      "maxDuration": 60,
      "includeFiles": "app/**"
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/backup?full=1",
      "schedule": "30 20 * * *"
    }
  ]
}
