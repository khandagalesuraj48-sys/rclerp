/* =====================================================================
 * RCL FLEET ERP – READ ME (Admin → Read Me)
 * The full guide to set up this app for a NEW site / project with its own blank database.
 * Only Admin can open it (the server sends it only to Admin).
 * Parts that follow the app by themselves: pages (MODULES), database tables and columns (SB_TABLES_),
 * the "auto" SQL, and the live status of THIS app. SQL files of every step are kept in README_SQL_ below –
 * every new module adds its SQL file here.
 * ===================================================================== */
function readme_() {
  const p = PropertiesService.getScriptProperties();
  const tables = (typeof SB_TABLES_ !== 'undefined') ? SB_TABLES_ : [];
  let url = '';
  try { url = ScriptApp.getService().getUrl() || ''; } catch (e) { url = ''; }
  let triggers = [];
  try { triggers = ScriptApp.getProjectTriggers().map(t => t.getHandlerFunction()); } catch (e) { triggers = []; }
  const key = p.getProperty('SUPABASE_SECRET_KEY') || '';
  const live = {
    supabaseUrl: p.getProperty('SUPABASE_URL') || '',
    defaultUrl: (typeof SB_DEFAULT_URL_ !== 'undefined') ? SB_DEFAULT_URL_ : '',
    keySet: !!key, keyEnd: key ? key.slice(-4) : '',
    dataSource: p.getProperty('DATA_SOURCE') || '',
    backupId: p.getProperty('SB_BACKUP_SHEET_ID') || '',
    webUrl: url, triggers: triggers,
    timeZone: Session.getScriptTimeZone(),
    company: APP.COMPANY, locations: APP.LOCATIONS || [],
  };
  const modules = MODULES.map(m => ({ key: m, label: MODULE_LABEL_[m] || m, info: README_MODULE_INFO_[m] || '' }));
  const tbl = tables.map(d => ({ table: d.table, tab: d.tab, cols: d.cols.map(c => c[1] + ' (' + c[0] + ')') }));
  const userCols = (tables.find(d => d.table === 'app_users') || { cols: [] }).cols;
  return {
    live: live, modules: modules, tables: tbl,
    sqlFiles: README_SQL_.map(x => ({ name: x.name, about: x.about, sql: x.sql })),
    sqlAll: README_SQL_.map(x => '-- ===== ' + x.name + ' =====\n' + x.sql).join('\n\n'),
    sqlAuto: readmeAutoSql_(tables),
    adminCols: userCols.map(c => ({ head: c[0], col: c[1] })),
  };
}
function readmePage_() {
  const d = readme_();
  return { html: readmeGuide_(d), adminCols: d.adminCols, modules: MODULES };
}
// always up to date: every table and column the app uses (new modules come in by themselves). Safe to run again.
function readmeAutoSql_(tables) {
  const out = ['-- AUTO SQL – made by the app from its own table list. Safe to run any number of times: it only ADDS what is missing.',
    '-- Run it AFTER the full setup SQL (it needs the functions made there).', ''];
  tables.forEach(d => {
    const t = 'public.' + d.table;
    out.push('-- ' + d.tab);
    out.push('create table if not exists ' + t + ' (id text primary key, extra jsonb, created_at timestamptz not null default now(), updated_at timestamptz not null default now());');
    d.cols.forEach(c => out.push('alter table ' + t + ' add column if not exists ' + c[1] + ' ' + (c[2] || 'text') + ';'));
    out.push('alter table ' + t + ' add column if not exists extra jsonb;');
    out.push('drop trigger if exists ' + d.table + '_touch on ' + t + ';');
    out.push('create trigger ' + d.table + '_touch before update on ' + t + ' for each row execute function public.touch_updated_at();');
    out.push('drop trigger if exists ' + d.table + '_deleted on ' + t + ';');
    out.push('create trigger ' + d.table + '_deleted after delete on ' + t + ' for each row execute function public.note_delete();');
    out.push('alter table ' + t + ' enable row level security;');
    out.push('create index if not exists ' + d.table + '_updated_at on ' + t + ' (updated_at);');
    out.push('grant select, insert, update, delete on ' + t + ' to service_role;');
    out.push('');
  });
  out.push('grant usage on schema public to service_role;');
  out.push('grant usage, select on all sequences in schema public to service_role;');
  return out.join('\n');
}
