    const sh = tankSheet_(), t = table_(APP.SHEET_TANK, TANK_COLS_);
    const n = t.rows.reduce((mx, r) => Math.max(mx, Number(String(r[t.c['Check ID']]).replace(/\D/g, '')) || 0), 0) + 1;
