function saveDebitRates_(rows) {
  return withLock_(() => {
    const t = table_(APP.SHEET_DIESEL, DIESEL_COLS_);
    if (!(H.DRATE in t.c)) { // first time: add the column at the end of Diesel Issue
      t.sh.getRange(1, t.headers.length + 1).setValue(H.DRATE);
