    appendRow: row => { drop(); return sh.appendRow(safeRows_(row)); },
    deleteRow: r => { drop(); return sh.deleteRow(r); },
    getRange: function () { drop(); return safeRange(sh.getRange.apply(sh, arguments)); },
    getLastRow: () => sh.getLastRow(),
