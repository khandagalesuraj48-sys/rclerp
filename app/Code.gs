    const all = PropertiesService.getScriptProperties().getProperties();
    got = {};
    SYNC_KEYS_.forEach(k => { got[k] = all[k] || '0'; });
    cache.putAll(got, 21600);
  }
  const v = {};
  SYNC_KEYS_.forEach(k => { v[k.slice(2)] = got[k] || '0'; });
