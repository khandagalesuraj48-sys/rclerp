    rateText: rateLabel_(f), vendors: out,
    total: { qty: r2_(out.reduce((s, v) => s + v.qty, 0)), amount: r2_(out.reduce((s, v) => s + v.amount, 0)), entries: list.length, machines: out.reduce((s, v) => s + v.machines, 0) },
