    const v = vendors[k];
    v.rows.sort((a, b) => a.date < b.date ? -1 : a.date > b.date ? 1 : natCmp_(a.no, b.no));
    v.machines = Object.keys(v.machines).length;
    v.rate = v.qty ? r2_(v.amount / v.qty) : 0;
