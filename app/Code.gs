      if ((e.open || isExtraPump_(T.it.rows[e.idx][T.it.c[H.PUMP]])) && !(r > 0)) { stock += q; return; } // opening / extra diesel with no rate: stock only
      avg = stock > 0 ? (stock * avg + q * r) / (stock + q) : r;
      stock += q; last = r;
    } else if (e.kind === 'issue') {
