    const sh = SS_().getSheetByName(name);
    if (!sh) throw new Error('Tab "' + name + '" not found in the Google Sheet. Run setupDieselStock and setupLogin (Setup.gs) once.');
    const lastCol = Math.max(sh.getLastColumn(), 1);
