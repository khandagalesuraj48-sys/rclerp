    (d.vendors || []).forEach(v => (v.rows || []).forEach(r => {
      const k = noKey_(r.no); out[k] = out[k] || { qty: 0, amount: 0 };
      out[k].qty = r2_(out[k].qty + r.qty); out[k].amount = r2_(out[k].amount + r.amount);
    }));
  } catch (e) { /* no debit diesel */ }
