    made: new Date(now).toISOString(), claimBy: new Date(now + CAP_CLAIM_S_ * 1000).toISOString(), ends: new Date(now + CAP_LIFE_S_ * 1000).toISOString(), max: siteRules_().attachMax || ATT_MAX_DEFAULT_ };
  capPut_(id, o);
