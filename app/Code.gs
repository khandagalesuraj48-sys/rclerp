        note = 'guard: ' + ((g[0] && g[0].value) || 'warn') + ' · changes of locked entries not by the Super Admin in 30 days: ' + w.length + (w.length ? ' (' + [...new Set(w.map(x => x.entry_key))].slice(0, 5).join(', ') + ')' : ''); } catch (e) { note = ''; } }
