  t.rows.filter(r => same_(r[t.c[H.NO]], no) && dkey_(r[t.c[H.IDATE]]) === dk && str_(r[t.c[H.SHIFT]]) === shift).sort((a, b) => cmpDiesel_(a, b, t.c)).forEach(r => {
