  return { key: [dk, shiftOrder_(str_(r[t.c[H.SHIFT]])), r[t.c[H.CREATED]] instanceof Date ? r[t.c[H.CREATED]].getTime() : 0], km: numOrBlank_(r[t.c[H.KMR]]), hr: numOrBlank_(r[t.c[H.HRR]]), at: 'fill of ' + dmy_(dk) + ', ' + str_(r[t.c[H.SHIFT]]) }; });
