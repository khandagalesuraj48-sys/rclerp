};
const SHEET_GROUPS_ = {
  'Master': ['master'], 'Diesel Inward': ['stock'], 'Diesel Transfer': ['stock'], 'Diesel Issue': ['stock', 'log'],
  'Log Book': ['log'], 'Users': ['users'], 'Activity Log': ['activity'], 'Tank Check': ['log'],
