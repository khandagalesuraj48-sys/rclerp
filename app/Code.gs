    driver: str_(r[t.c[H.DRIVER]]), okm: numOrBlank_(r[t.c[H.OKM]]), ckm: numOrBlank_(r[t.c[H.CKM]]), ohr: numOrBlank_(r[t.c[H.OHR]]), chr: numOrBlank_(r[t.c[H.CHR]]),
